# ---- Slack ---------------------------------------------------------------
# 봇 토큰 (OAuth & Permissions > Bot User OAuth Token). slack_manifest.yaml 로 앱을 만들면 스코프가 맞춰져 있음.
SLACK_BOT_TOKEN=xoxb-...
# Socket Mode 용 앱 레벨 토큰 (Basic Information > App-Level Tokens, scope: connections:write). poll 모드만 쓸 거면 비워도 됨.
SLACK_APP_TOKEN=xapp-...
# 감시할 채널. 서논술형 CS 채널.
SLACK_CHANNEL_ID=C09C51FCLPP

# ---- Claude --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (초안 품질 vs 비용)
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=16000
# 안전 분류기 거절 시 서버가 대체 모델로 재실행. Bedrock/Vertex 등에서는 false.
CLAUDE_FALLBACKS=true

# ---- Notion 가이드 -------------------------------------------------------
# 내부 통합(Integration) 토큰. 가이드 페이지를 이 통합에 공유(Connections)해야 읽힘.
NOTION_TOKEN=
# 서논술형 RAG 가이드 Notion 페이지 ID. 아직 미지정(비움) — 지정 전까지는 저장소 스냅샷 사용.
NOTION_PAGE_ID=
# 노션에서 다시 읽어오는 주기(분)
GUIDE_REFRESH_MINUTES=60

# ---- 동작 ----------------------------------------------------------------
# true 면 슬랙에 올리지 않고 터미널에만 출력
DRY_RUN=false
# 과거 이력(개인화·few-shot)을 찾을 기간(일)
CONTEXT_HISTORY_DAYS=120
MAX_PRIOR_INQUIRIES=3
MAX_SIMILAR_EXAMPLES=3
# poll 모드 주기(초)
POLL_INTERVAL_SECONDS=60
# 처리 완료 ts 저장 파일
STATE_FILE=.state/seononsul_processed.json
