# 서논술형 시스템(#clipo-ai-서논술형시스템-cs) 프로파일용 .env 예시.
# 기존 #clipo-cs 봇과 별도 인스턴스로 이 값들을 채워 실행하세요.

# ---- Slack ---------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# 감시 채널: #clipo-ai-서논술형시스템-cs 의 채널 ID (Slack 채널 상세 > 하단 채널 ID)
SLACK_CHANNEL_ID=

# ---- Claude --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=16000
CLAUDE_FALLBACKS=true

# ---- 가이드(RAG 참조 문서) -----------------------------------------------
# 서논술형 전용 가이드 스냅샷을 폴백으로 사용. 노션을 쓰면 NOTION_TOKEN + 페이지 ID 설정.
NOTION_TOKEN=
NOTION_GUIDE_PAGE_ID=
GUIDE_REFRESH_MINUTES=60
GUIDE_FALLBACK_PATH=guide/seononsul_guide.md

# ---- 매뉴얼 RAG ----------------------------------------------------------
# 이 디렉터리의 .md/.markdown/.txt 매뉴얼을 제품 사실 근거로 함께 참조.
MANUALS_DIR=manuals

# ---- 관련 내부 채널 참조 --------------------------------------------------
# 이름에 아래 키워드가 들어간 회사 채널의 최근 논의를 맥락으로 참조(봇이 해당 채널에 초대되어 있어야 함).
REFERENCE_CHANNEL_KEYWORD=clipo-ai-서논술형시스템
# 또는 채널 ID를 직접 지정(쉼표 구분). 지정 시 키워드 검색 대신 이 목록을 사용.
REFERENCE_CHANNEL_IDS=
REFERENCE_HISTORY_DAYS=30
REFERENCE_PER_CHANNEL=15
REFERENCE_MAX_CHANNELS=6

# ---- 담당 조직 태깅 ------------------------------------------------------
# [에스컬레이션] 라벨(개발팀/AI조직 등)을 실제 Slack 멘션으로 자동 태그. stakeholders.example.json 복사해 채우세요.
STAKEHOLDER_MAP_PATH=stakeholders.json

# ---- 동작 ----------------------------------------------------------------
DRY_RUN=true
CONTEXT_HISTORY_DAYS=120
MAX_PRIOR_INQUIRIES=3
MAX_SIMILAR_EXAMPLES=3
POLL_INTERVAL_SECONDS=60
STATE_FILE=.state/processed.seononsul.json
